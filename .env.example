# ============================================================================
# video-search-kit — configuration & secrets
#
#   cp .env.example .env      then fill in the values marked (required).
#   Values containing spaces must stay double-quoted (the file is shell-sourced).
#   .env is gitignored; never commit real keys.
#
# The pipeline scripts and the webapp both read this file (they load it via
# `set -a; . ./.env` or python-dotenv-free os.environ — see README).
# ============================================================================

# --- GoodMem instance (required) --------------------------------------------
# Your GoodMem server and its API key. Everything is stored and searched here.
# Local instances usually serve HTTPS with a self-signed certificate — use
# https://localhost:8080 and set GOODMEM_TLS_VERIFY=0.
GOODMEM_BASE_URL=https://your-goodmem-instance.example.com
GOODMEM_API_KEY=gm_...
GOODMEM_TLS_VERIFY=1

# --- Embedder (required for setup) ------------------------------------------
# Provider API key used ONCE by pipeline/setup.py to register the embedding
# model inside GoodMem (GoodMem stores it server-side and calls the provider
# itself at ingest/search time). Voyage is the tested default.
EMBEDDER_MODEL=voyage-3-large
EMBEDDER_API_KEY=pa-...

# --- Reranker (recommended) -------------------------------------------------
# Same idea: registered into GoodMem by setup.py. Usually the same Voyage key.
# Leave RERANKER_API_KEY empty to skip reranking (search still works; the
# relevance gate then uses RELEVANCE_FLOOR_NORERANK).
RERANKER_MODEL=rerank-2.5
RERANKER_API_KEY=pa-...

# --- LLM for the AI summary (optional) --------------------------------------
# Called directly by the webapp (OpenAI-compatible /chat/completions).
# Works with OpenRouter, OpenAI, Groq, or any compatible endpoint.
# Leave OPENROUTER_API_KEY empty to run without AI summaries.
OPENROUTER_API_KEY=sk-or-...
ANSWER_MODEL=openai/gpt-4.1-mini

# --- Transcription (only needed if you use pipeline/transcribe.py) ----------
# Any OpenAI-compatible Whisper endpoint. Examples:
#   OpenAI: https://api.openai.com/v1      model: whisper-1
#   Groq:   https://api.groq.com/openai/v1 model: whisper-large-v3-turbo
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# If YouTube answers audio downloads with "Sign in to confirm you're not a
# bot" (common on flagged/datacenter IPs), set this to a browser you're logged
# into YouTube with — yt-dlp reuses its cookies. e.g. chrome, firefox, edge
YTDLP_COOKIES_FROM_BROWSER=

# --- YouTube Data API (required for pipeline/discover.py) -------------------
# Free key from Google Cloud Console -> enable "YouTube Data API v3" ->
# Credentials -> API key.
YOUTUBE_API_KEY=

# ============================================================================
# Everything below is filled in by `python pipeline/setup.py` (it prints the
# lines to add) or has sensible defaults. You normally don't edit these first.
# ============================================================================

# Written by setup.py after it provisions your GoodMem instance:
GOODMEM_SPACE_ID=
GOODMEM_TITLE_SPACE_ID=
GOODMEM_RERANKER_ID=

# --- Site branding ----------------------------------------------------------
SITE_NAME="Video Search"
SITE_TAGLINE="Ask a question — every result links to the exact moment in the video it came from."
EXAMPLE_QUERY="e.g. What does the speaker say about patience?"
APP_STAGE=Alpha
APP_VERSION=0.1

# --- Retrieval tuning (tested defaults) -------------------------------------
TITLE_WEIGHT=0.6
BODY_WEIGHT=0.4
RELEVANCE_FLOOR=0.68            # confidence gate when the reranker is ON
RELEVANCE_FLOOR_NORERANK=0.6    # confidence gate when the reranker is OFF
RETRIEVE_POOL=50                # candidates pulled from the embedder (all reranked)
ENABLE_KEYWORD_INDEX=1          # local exact-match index (direct-hit override)

# --- Data locations (defaults match the pipeline output) --------------------
TRANSCRIPTS_DIR=./data/transcripts
VIDEOS_CSV=./data/videos.csv
CHUNK_WINDOW=60
CHUNK_OVERLAP=15
