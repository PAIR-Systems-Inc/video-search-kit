# Deploy to Fly.io (optional path — any Docker host works).
#
#   cp deploy/fly.toml.example fly.toml         # edit app name
#   fly launch --no-deploy                      # or: fly apps create <name>
#   cat .env | fly secrets import               # secrets live in Fly, not the image
#   fly deploy --dockerfile deploy/Dockerfile
#
app = 'CHANGE-ME'
primary_region = 'iad'

[build]
  dockerfile = 'deploy/Dockerfile'

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = 'suspend'   # suspend keeps the built keyword index in RAM
  auto_start_machines = true
  min_machines_running = 0

[[http_service.checks]]
  grace_period = "20s"
  interval = "30s"
  method = "GET"
  path = "/healthz"
  timeout = "5s"

[[vm]]
  size = 'shared-cpu-1x'
  memory = '1gb'   # bump if your keyword index is large (~600MB per 70k chunks)
